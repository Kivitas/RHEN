{
  "run_dir": "runs/v2/r2_50m_decision",
  "stage": "decision",
  "seed": 0,
  "preset": "r2-50m",
  "notes": "Plan 7.3: 45% teacher-labelled, 35% converted public, 20% programmatic synthetic, plus 10% span-choice retained. Mixed batches of about 64 questions. Starts from the stage-1 EMA weights in init_from. Plan 10.3 gates must pass before 300M starts.",
  "init_from": "runs/v2/r2_50m_pretrain",
  "teacher_jsonl": [
    "data/v2/teacher/train.jsonl"
  ],
  "converted_jsonl": [
    "data/v2/converted/train.jsonl"
  ],
  "synthetic": [
    {
      "n": 200000,
      "seed": 1,
      "unanswerable_rate": 0.12
    }
  ],
  "decision_weights": {
    "teacher": 0.45,
    "converted": 0.35,
    "synthetic": 0.2
  },
  "span_choice_frac": 0.1,
  "pretrain_corpus_dir": "data/v2/corpus",
  "eval_jsonl": [],
  "eval_synthetic": {
    "split": "val",
    "n": 2000,
    "seed": 1
  },
  "steps": 30000,
  "batch_questions": 64,
  "grad_accum": 1,
  "lr": 0.00015,
  "base_width": 512,
  "precision": "bf16",
  "ema_decay": 0.999,
  "dist_strategy": "none",
  "log_every": 50,
  "eval_every": 1000,
  "save_every": 1000,
  "keep_last": 3
}
