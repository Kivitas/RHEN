{
  "run_dir": "runs/lm_small",
  "preset": "small",
  "device": "auto",
  "precision": "auto",
  "lm_data": "data/corpus",
  "seq_len": 1024,
  "micro_batch_size": 8,
  "grad_accum_steps": 4,
  "optimizer": "muon",
  "lr": 0.0006,
  "muon_lr": 0.02,
  "schedule": "wsd",
  "warmup_steps": 500,
  "max_steps": 20000,
  "decay_fraction": 0.2,
  "log_every": 20,
  "eval_every": 1000,
  "eval_lm_batches": 50,
  "save_every": 1000,
  "tensorboard": true
}
