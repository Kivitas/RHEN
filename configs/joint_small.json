{
  "run_dir": "runs/joint_small",
  "preset": "small",
  "device": "auto",
  "precision": "auto",
  "lm_data": "data/corpus",
  "seq_len": 1024,
  "micro_batch_size": 8,
  "grad_accum_steps": 4,
  "decision_train": "data/decisions/train.jsonl",
  "decision_val": "data/decisions/val.jsonl",
  "decision_batch_size": 8,
  "decision_every": 2,
  "decision_loss_coef": 0.5,
  "order_consistency_coef": 0.1,
  "optimizer": "muon",
  "lr": 0.0006,
  "schedule": "wsd",
  "warmup_steps": 500,
  "max_steps": 20000,
  "log_every": 20,
  "eval_every": 1000,
  "eval_lm_batches": 50,
  "eval_decision_examples": 500,
  "save_every": 1000,
  "tensorboard": true
}
