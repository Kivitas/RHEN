{
  "run_dir": "runs/base_fsdp",
  "preset": "base",
  "device": "auto",
  "precision": "bf16",
  "strategy": "fsdp",
  "gradient_checkpointing": true,
  "lm_data": "data/corpus",
  "seq_len": 2048,
  "micro_batch_size": 4,
  "grad_accum_steps": 8,
  "decision_train": "data/decisions/train.jsonl",
  "decision_val": "data/decisions/val.jsonl",
  "decision_every": 4,
  "decision_loss_coef": 0.5,
  "order_consistency_coef": 0.1,
  "optimizer": "adamw",
  "lr": 0.0003,
  "schedule": "cosine",
  "warmup_steps": 2000,
  "max_steps": 100000,
  "log_every": 20,
  "eval_every": 2000,
  "eval_lm_batches": 100,
  "save_every": 2000,
  "keep_last": 5,
  "wandb_project": "eos"
}
