# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicit text files
*.py text eol=lf diff=python
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.jinja text eol=lf
*.cff text eol=lf
*.sh text eol=lf

# Windows command files
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.whl binary
*.gz binary
*.zip binary
*.bin binary
*.pt binary
*.pth binary
*.safetensors binary
